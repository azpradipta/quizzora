# Salin menjadi .env.local lalu isi dari Supabase > Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Formulir "Hubungi pengembang" di halaman login → dikirim ke email Anda.
# Daftar gratis di https://web3forms.com (masukkan email tujuan, access key dikirim ke email itu).
VITE_WEB3FORMS_KEY=
